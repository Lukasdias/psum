{
  "name": "psum",
  "version": "0.1.0",
  "description": "Project Structure Summarizer - Fast, AI-optimized codebase overview",
  "module": "src/cli.ts",
  "type": "module",
  "bin": {
    "psum": "./dist/cli.js"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun run build.ts",
    "compile": "bun build --compile --outfile=./dist/psum src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "fast-glob": "^3.3.2",
    "picocolors": "^1.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/bun": "latest"
  },
  "keywords": [
    "cli",
    "project-structure",
    "codebase-analyzer",
    "dependency-graph",
    "ai-tool"
  ],
  "license": "MIT",
  "engines": {
    "bun": ">=1.0.0"
  }
}